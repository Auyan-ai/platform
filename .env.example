# Auyan — Plantilla de variables de entorno
# Copiar a `.env` y completar. Nunca commitear `.env` con valores reales.

# ----------------------------------------------------------------
# App
# ----------------------------------------------------------------
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# ----------------------------------------------------------------
# Database — Supabase Postgres (conexión directa)
# ----------------------------------------------------------------
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Tomar del dashboard de Supabase → Project Settings → Database → Connection string (URI).
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.CHANGE_ME.supabase.co:5432/postgres

SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME       # server-only, NUNCA exponer al frontend
SUPABASE_ANON_KEY=CHANGE_ME               # ok para clientes públicos

DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# ----------------------------------------------------------------
# LLM providers
# ----------------------------------------------------------------
ANTHROPIC_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME                  # usado sólo para embeddings (text-embedding-3-small)

# ----------------------------------------------------------------
# WhatsApp (Zernio) y notas de voz — Sprint 2 (ADR 0010 / ADR 0011)
# ----------------------------------------------------------------
TRANSCRIPTION_PROVIDER=                    # vacío = no se transcribe; "openai" (provisional)
TRANSCRIPTION_MODEL=gpt-4o-transcribe
TRANSCRIPTION_MAX_SECONDS=300
# ZERNIO_API_KEY NO va aquí: es la key MAESTRA y deploy_cloud_run.sh sube todo este archivo
# a Cloud Run. Va en un `.env.zernio` local aparte (ver docs/runbooks/whatsapp-onboarding.md).
AUYAN_API_BASE_URL=                        # URL pública de la API (webhook de Zernio)

# ----------------------------------------------------------------
# Observability — LangSmith primary, Langfuse mirror
# ----------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=auyan-staging
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=

LANGFUSE_PUBLIC_KEY=CHANGE_ME
LANGFUSE_SECRET_KEY=CHANGE_ME
LANGFUSE_HOST=https://cloud.langfuse.com

# ----------------------------------------------------------------
# CORS
# ----------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000     # Separar múltiples con coma. En Railway: URL del apps/web

# ----------------------------------------------------------------
# Frontend público — apps/web + apps/landing
# ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://CHANGE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Producción: https://app.auyan.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001 # Producción: https://auyan.ai
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ----------------------------------------------------------------
# Webhook security
# ----------------------------------------------------------------
WEBHOOK_SECRET=CHANGE_ME                  # HMAC shared secret para validar webhooks entrantes

# ----------------------------------------------------------------
# Auth — Supabase JWT
# ----------------------------------------------------------------
# Tomar del dashboard de Supabase → Project Settings → API → JWT secret.
# Por defecto Supabase firma JWTs con HS256 y audience='authenticated'.
SUPABASE_JWT_SECRET=CHANGE_ME
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated

# Cache en memoria del lookup de usuarios para auth.
# TTL bajo (60s) = los cambios de role/tenant tardan max ese tiempo en propagarse.
# maxsize acota la memoria: 1000 ≈ 1000 usuarios activos concurrentes.
AUTH_USER_CACHE_TTL_SECONDS=60
AUTH_USER_CACHE_MAXSIZE=1000

# ----------------------------------------------------------------
# Defaults del agente (override por tenant en tenant_configurations)
# ----------------------------------------------------------------
DEFAULT_AGENT_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.6
HISTORY_LIMIT=20
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=30

# ----------------------------------------------------------------
# Cifrado de credentials de integraciones (tenant_integrations table)
# ----------------------------------------------------------------
# Clave maestra AES-256-GCM. Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Rotar con cuidado: cambiar la key invalida credentials ya guardadas en DB.
INTEGRATIONS_SECRET_KEY=CHANGE_ME

# ----------------------------------------------------------------
# Integraciones de canales externos (clientes HTTP en `integrations/`)
# Vacío hasta que cableemos cada canal. Las keys NO se cargan en Settings
# hasta que un módulo concreto las lea.
# ----------------------------------------------------------------
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_WEBHOOK_SECRET_TOKEN=
CHATWOOT_ESCALATION_TEAM_ID=

# Shopify test store para Agent Verification Staging.
SHOPIFY_TEST_DOMAIN=
SHOPIFY_TEST_ACCESS_TOKEN=
# ----------------------------------------------------------------
# Postmark (email outbound Auyan → cliente: escalaciones, reportes, notificaciones)
# Obtener server token en https://account.postmarkapp.com/servers
# El dominio de POSTMARK_FROM_EMAIL debe estar verificado en Postmark.
# ----------------------------------------------------------------
POSTMARK_API_TOKEN=
POSTMARK_FROM_EMAIL=noreply@auyan.ai
POSTMARK_FROM_NAME=Auyan

# ----------------------------------------------------------------
# Zendesk OAuth (sub-PR 0.5)
# Registrar en https://www.zendesk.com/partner/programs/technology/
# Redirect URI: {API_BASE_URL}/oauth/zendesk/callback
# ----------------------------------------------------------------
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=
ZENDESK_OAUTH_REDIRECT_URI=https://api.auyan.ai/oauth/zendesk/callback

# ----------------------------------------------------------------
# Gorgias OAuth (sub-PR 0.6)
# Registrar en https://www.gorgias.com/integrations/developer
# Redirect URI: {API_BASE_URL}/oauth/gorgias/callback
# ----------------------------------------------------------------
GORGIAS_OAUTH_CLIENT_ID=
GORGIAS_OAUTH_CLIENT_SECRET=
GORGIAS_OAUTH_REDIRECT_URI=https://api.auyan.ai/oauth/gorgias/callback
