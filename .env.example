# Auyan — Plantilla de variables de entorno
# Copiar a `.env` y completar. Nunca commitear `.env` con valores reales.

# ----------------------------------------------------------------
# App
# ----------------------------------------------------------------
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# ----------------------------------------------------------------
# Database — Supabase Postgres (conexión directa)
# ----------------------------------------------------------------
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Tomar del dashboard de Supabase → Project Settings → Database → Connection string (URI).
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.CHANGE_ME.supabase.co:5432/postgres

SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME       # server-only, NUNCA exponer al frontend
SUPABASE_ANON_KEY=CHANGE_ME               # ok para clientes públicos

DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# ----------------------------------------------------------------
# LLM providers
# ----------------------------------------------------------------
ANTHROPIC_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME                  # usado sólo para embeddings (text-embedding-3-small)

# ----------------------------------------------------------------
# Observability — Langfuse
# ----------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=CHANGE_ME
LANGFUSE_SECRET_KEY=CHANGE_ME
LANGFUSE_HOST=https://cloud.langfuse.com

# ----------------------------------------------------------------
# Webhook security
# ----------------------------------------------------------------
WEBHOOK_SECRET=CHANGE_ME                  # HMAC shared secret para validar webhooks entrantes

# ----------------------------------------------------------------
# Auth — Supabase JWT
# ----------------------------------------------------------------
# Tomar del dashboard de Supabase → Project Settings → API → JWT secret.
# Por defecto Supabase firma JWTs con HS256 y audience='authenticated'.
SUPABASE_JWT_SECRET=CHANGE_ME
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated

# Cache en memoria del lookup de usuarios para auth.
# TTL bajo (60s) = los cambios de role/tenant tardan max ese tiempo en propagarse.
# maxsize acota la memoria: 1000 ≈ 1000 usuarios activos concurrentes.
AUTH_USER_CACHE_TTL_SECONDS=60
AUTH_USER_CACHE_MAXSIZE=1000

# ----------------------------------------------------------------
# Defaults del agente (override por tenant en tenant_configurations)
# ----------------------------------------------------------------
DEFAULT_AGENT_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.6
HISTORY_LIMIT=20
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=30

# ----------------------------------------------------------------
# Integraciones de canales externos (clientes HTTP en `integrations/`)
# Vacío hasta que cableemos cada canal. Las keys NO se cargan en Settings
# hasta que un módulo concreto las lea.
# ----------------------------------------------------------------
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_API_TOKEN=
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
POSTMARK_API_TOKEN=
