   "response": [
    {
     "slug": "envios",
     "link": "https://tienda-prueba.test/envios/",
     "title": {
      "rendered": "Envíos"
     },
     "content": {
      "rendered": "<p>Enviamos en 24-48 horas laborables a toda la península. Gratis a partir de 50 euros.</p>\n",
